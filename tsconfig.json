{
  "compilerOptions": {
    "target": "esnext",
    "lib": ["ESNext", "DOM"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "verbatimModuleSyntax": true,
    "skipLibCheck": true
  },
  "include": [
    "benchmarks/**/*.ts",
    "src/**/*.ts",
    "tests/**/*.ts",
    "playwright.config.ts",
    "tsdown.config.ts",
    "vitest.config.ts"
  ]
}
